      "name": "10 Serie con una fecha en el bloqueo (los lunes a las 12:00) → 409 APPOINTMENT_SERIES_CONFLICT con la lista",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
              "pm.test('error_code APPOINTMENT_SERIES_CONFLICT', () => pm.expect(pm.response.json().error_code).to.eql('APPOINTMENT_SERIES_CONFLICT'));",
              "const conflicts = pm.response.json().errors.conflicts;",
              "pm.test('Una sola fecha en conflicto: la del bloqueo, con su motivo', () => {",
              "    pm.expect(conflicts).to.have.length(1);",
              "    pm.expect(conflicts[0].reason).to.eql('in_block');",
              "    pm.expect(conflicts[0].starts_at.slice(0, 16)).to.eql(`${pm.collectionVariables.get('week2')}T15:00`);",
              "    pm.expect(conflicts[0].message).to.eql('La agenda está bloqueada en ese horario.');",
              "});"
            ]
          }
        }
