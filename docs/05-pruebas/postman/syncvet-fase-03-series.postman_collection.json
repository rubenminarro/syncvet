      "name": "08 Serie semanal de 4 turnos (los lunes a las 10:00) → 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('4 turnos con el mismo series_id', () => {",
              "    pm.expect(json.data).to.have.length(4);",
              "    json.data.forEach(a => pm.expect(a.series_id).to.eql(json.meta.series_id));",
              "});",
              "pm.test('Un lunes por semana, a las 10:00 de Asunción (13:00 UTC)', () => {",
              "    const days = ['monday', 'week1', 'week2', 'week3'].map(v => pm.collectionVariables.get(v));",
              "    pm.expect(json.data.map(a => a.starts_at.slice(0, 16))).to.eql(days.map(d => `${d}T13:00`));",
              "});",
              "pm.collectionVariables.set('weekly_series_id', json.meta.series_id);",
              "json.data.forEach((a, i) => pm.collectionVariables.set(`weekly_${i}`, String(a.id)));"
            ]
          }
        }
