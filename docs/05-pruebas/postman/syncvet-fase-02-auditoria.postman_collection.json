        {
            "name": "05 Filtrar por fecha con Z, tipo, id y evento",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "pm.test('Los dos registros de la corrida', () => pm.expect(json.data.length).to.eql(2));",
                            "pm.test('Del más nuevo al más viejo', () => pm.expect(json.data[0].id).to.be.above(json.data[1].id));",
                            "pm.test('Evento con su etiqueta', () => pm.expect(json.data[0].event).to.eql({ value: 'updated', label: 'Modificado' }));",
                            "pm.test('Tipo e id del cliente', () => { pm.expect(json.data[0].auditable_type).to.eql('client'); pm.expect(json.data[0].auditable_id).to.eql(Number(pm.collectionVariables.get('client_id'))); });",
                            "pm.test('Usuario: el administrador', () => pm.expect(json.data[0].user.id).to.eql(Number(pm.collectionVariables.get('admin_id'))));",
                            "pm.test('Fecha en UTC', () => pm.expect(json.data[0].created_at).to.match(/Z$/));",
                            "pm.test('El listado no trae los valores', () => { pm.expect(json.data[0]).to.not.have.property('old_values'); pm.expect(json.data[0]).to.not.have.property('new_values'); });",
                            "pm.collectionVariables.set('audit_id', String(json.data[1].id));",
                            "pm.collectionVariables.set('audit_ids', JSON.stringify(json.data.map(log => log.id)));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
