        {
            "name": "02 El administrador lee la configuración (y la guarda para restaurarla)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "pm.test('Datos de la clínica con el RUC', () => pm.expect(json.data.clinic).to.have.all.keys('name', 'legal_name', 'ruc', 'ruc_dv'));",
                            "pm.test('Las cuatro claves, sin logo_path', () => pm.expect(json.data.settings).to.have.all.keys('contact_email', 'contact_phone', 'website', 'document_footer'));",
                            "// La corrida deja la clínica como estaba: guarda los datos y las claves para restaurarlos al final.",
                            "pm.collectionVariables.set('original', JSON.stringify({ name: json.data.clinic.name, legal_name: json.data.clinic.legal_name, settings: json.data.settings }));",
                            "pm.test('La clínica A empieza sin logo (si no, la corrida se detiene sin tocar nada)', () => pm.expect(json.data.has_logo).to.eql(false));",
                            "if (json.data.has_logo) { postman.setNextRequest(null); }"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/system-settings",
                    "host": [
                        "{{base_url}}"
