        {
            "name": "05 Editar los datos y las claves",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "const run = pm.collectionVariables.get('run');",
                            "pm.test('Nombre nuevo', () => pm.expect(json.data.clinic.name).to.eql('Clínica A ' + run));",
                            "pm.test('Correo en minúsculas', () => pm.expect(json.data.settings.contact_email).to.eql('contacto.' + run + '@mailinator.com'));",
                            "pm.test('Teléfono, sitio y pie', () => { pm.expect(json.data.settings.contact_phone).to.eql('+595981555000'); pm.expect(json.data.settings.website).to.eql('https://clinica-a.example.com'); pm.expect(json.data.settings.document_footer).to.eql('Gracias por su visita (' + run + ').'); });"
                        ]
                    }
                }
            ],
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/system-settings",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "system-settings"
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Clínica A {{run}}\",\n    \"settings\": {\n        \"contact_email\": \"Contacto.{{run}}@mailinator.com\",\n        \"contact_phone\": \"+595981555000\",\n        \"website\": \"https://clinica-a.example.com\",\n        \"document_footer\": \"Gracias por su visita ({{run}}).\"\n    }\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{token_admin}}",
                            "type": "string"
                        }
                    ]
                }
            }
