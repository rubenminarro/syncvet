            "roles": [
                "administrador",
                "veterinario"
            ]
        },
        {
            "name": "no_show",
            "from": [
                "pending_confirmation",
                "confirmed"
            ],
            "to": "no_show",
            "path": "no-show",
            "permission": "appointments.no-show",
            "roles": [
                "administrador",
                "recepcionista"
            ]
        },
        {
            "name": "undo_no_show",
            "from": [
                "no_show"
            ],
            "to": "confirmed",
            "path": "undo-no-show",
            "permission": "appointments.no-show",
            "roles": [
                "administrador",
                "recepcionista"
            ]
        },
        {
