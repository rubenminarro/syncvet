APP_NAME=SyncVet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://syncvet.test

# Orígenes del navegador que pueden llamar a la API (CORS), separados por comas. Vacío: ninguno.
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 de Laragon. Crear la base en utf8mb4: CREATE DATABASE syncvet CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=syncvet
DB_USERNAME=root
DB_PASSWORD=
# Zona de la sesión de MySQL (cómo guarda las columnas timestamp), no la de la aplicación
# (America/Asuncion, config/app.php). Un desplazamiento fijo: MySQL no tiene cargadas las zonas con nombre.
# No dejarla vacía (vacía toma -03:00; otro valor inválido rompe toda conexión).
DB_TIMEZONE=-03:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Validar que el dominio del email exista (consulta DNS). phpunit.xml lo desactiva.
EMAIL_DNS_CHECK=true

# Minutos de vida de un token de la API (12 horas, registro R-004).
SANCTUM_EXPIRATION=720

# Proxies de confianza (IP o CIDR separados por coma, o *). Vacía: ninguno. Ver docs/04-desarrollo/deployment.md.
TRUSTED_PROXIES=

# Contraseña de los usuarios del DemoSeeder (solo local y testing). Al menos 12 caracteres, con mayúsculas, minúsculas, números y símbolos.
# Sin valor, el DemoSeeder no corre. Ver README.md.
DEMO_PASSWORD=
